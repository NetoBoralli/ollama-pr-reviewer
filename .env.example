# Which backend to use: "ollama" (local), "openai" (any OpenAI-compatible API),
# or "anthropic" (native Anthropic SDK with prompt caching).
LLM_PROVIDER=ollama

# --- Ollama (default, local, free) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Hosted OpenAI-compatible API ---
# Works for OpenAI, OpenRouter, Together, Groq, self-hosted vLLM/TGI, etc.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Anthropic (recommended for CI) ---
# Uses native cache_control on the system prompt for ~90% input cost reduction
# on cache hits.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...
