# Which backend to use: "ollama" (local, free) or "openai" (any hosted OpenAI-compatible API).
LLM_PROVIDER=ollama

# --- Ollama (default) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Hosted OpenAI-compatible API (used when LLM_PROVIDER=openai) ---
# Works for OpenAI, OpenRouter, Together, Groq, etc. — just change baseURL + model.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
